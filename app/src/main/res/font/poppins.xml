<?xml version="1.0" encoding="utf-8"?>
<!-- Poppins (SIL Open Font License, from Google Fonts). Bold text uses the
     700 weight, buttons and labels the 500/600 ones where styles ask. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:font="@font/poppins_regular" android:fontStyle="normal" android:fontWeight="400" />
    <font android:font="@font/poppins_medium" android:fontStyle="normal" android:fontWeight="500" />
    <font android:font="@font/poppins_semibold" android:fontStyle="normal" android:fontWeight="600" />
    <font android:font="@font/poppins_bold" android:fontStyle="normal" android:fontWeight="700" />
</font-family>
