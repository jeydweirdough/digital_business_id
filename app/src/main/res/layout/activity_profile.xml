<?xml version="1.0" encoding="utf-8"?>
<!-- "Edit my details" (ProfileActivity). Fields the backend doesn't list in
     profileFields are hidden in code. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- Top bar: back + title. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="-12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/edit_details"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/intro"
            style="@style/Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/fullNameLabel"
            style="@style/Label"
            android:layout_marginTop="24dp"
            android:text="@string/edit_full_name" />

        <EditText
            android:id="@+id/fullName"
            style="@style/Field"
            android:imeOptions="actionNext"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="100"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/jobTitleLabel"
            style="@style/Label"
            android:layout_marginTop="20dp"
            android:text="@string/edit_job_title" />

        <EditText
            android:id="@+id/jobTitle"
            style="@style/Field"
            android:imeOptions="actionNext"
            android:inputType="textCapWords"
            android:maxLength="120"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/mobileLabel"
            style="@style/Label"
            android:layout_marginTop="20dp"
            android:text="@string/edit_mobile" />

        <EditText
            android:id="@+id/mobile"
            style="@style/Field"
            android:imeOptions="actionNext"
            android:inputType="phone"
            android:maxLength="40"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/otherMobilesLabel"
            style="@style/Label"
            android:layout_marginTop="20dp"
            android:text="@string/edit_other_mobiles" />

        <EditText
            android:id="@+id/otherMobiles"
            style="@style/Field"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="@string/edit_other_mobiles_hint"
            android:inputType="phone|textMultiLine"
            android:maxLength="200"
            android:minLines="2"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/officePhoneLabel"
            style="@style/Label"
            android:layout_marginTop="20dp"
            android:text="@string/edit_office_phone" />

        <EditText
            android:id="@+id/officePhone"
            style="@style/Field"
            android:imeOptions="actionNext"
            android:inputType="phone"
            android:maxLength="40"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/whatsappLabel"
            style="@style/Label"
            android:layout_marginTop="20dp"
            android:text="@string/edit_whatsapp" />

        <EditText
            android:id="@+id/whatsapp"
            style="@style/Field"
            android:hint="@string/edit_same_as_mobile"
            android:imeOptions="actionNext"
            android:inputType="phone"
            android:maxLength="40"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/viberLabel"
            style="@style/Label"
            android:layout_marginTop="20dp"
            android:text="@string/edit_viber" />

        <EditText
            android:id="@+id/viber"
            style="@style/Field"
            android:hint="@string/edit_same_as_mobile"
            android:imeOptions="actionNext"
            android:inputType="phone"
            android:maxLength="40"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/wechatIdLabel"
            style="@style/Label"
            android:layout_marginTop="20dp"
            android:text="@string/edit_wechat" />

        <EditText
            android:id="@+id/wechatId"
            style="@style/Field"
            android:imeOptions="actionNext"
            android:inputType="text|textNoSuggestions"
            android:maxLength="40"
            android:textSize="16sp" />

        <Button
            android:id="@+id/save"
            style="@style/PrimaryButton"
            android:layout_marginTop="28dp"
            android:text="@string/edit_details_save" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/danger"
            android:textSize="15sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
