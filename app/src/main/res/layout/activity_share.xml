<?xml version="1.0" encoding="utf-8"?>
<!-- The QR screen, kept to what's needed while someone is scanning. The
     how-to, tap details, card switching and sign-out are one tap away in
     the ⋮ menu, the "How do they scan it?" link and the tap chip. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- Top bar: Contact us and the menu, on the right. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginEnd="-12dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/contactUs"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/contact_us"
                android:src="@drawable/ic_contact" />

            <ImageButton
                android:id="@+id/menu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/menu"
                android:src="@drawable/ic_more" />
        </LinearLayout>

        <TextView
            android:id="@+id/name"
            style="@style/Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/jobTitle"
            style="@style/Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_notice"
            android:padding="12dp"
            android:textColor="@color/warning_ink"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- How the QR and tap share: the website card (default) or the contact itself. -->
        <LinearLayout
            android:id="@+id/modeSwitch"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_segment"
            android:orientation="horizontal"
            android:padding="3dp">

            <LinearLayout
                android:id="@+id/modeWebsite"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center">

                <TextView
                    android:id="@+id/modeWebsiteTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_website"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/modeDirect"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center">

                <TextView
                    android:id="@+id/modeDirectTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_direct"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- The point of the app: the other person scans this. -->
        <ImageView
            android:id="@+id/qr"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_marginTop="24dp"
            android:contentDescription="@string/scan_qr" />

        <!-- One line: what scanning does in the selected mode. -->
        <TextView
            android:id="@+id/scanLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <!-- The step-by-step, in a pop-up rather than on screen. -->
        <Button
            android:id="@+id/howToScan"
            style="@style/TextButton"
            android:text="@string/how_to_scan" />

        <TextView
            android:id="@+id/sent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_sent"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/sent"
            android:textColor="#065F46"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Phone tap status; tap it for how-to or to turn NFC on. Hidden without NFC. -->
        <LinearLayout
            android:id="@+id/tapChip"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="16dp">

            <View
                android:id="@+id/tapDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_on" />

            <TextView
                android:id="@+id/tapText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/ink"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
